# Copy to /srv/apps/vaultwarden/.env (mode 600). See the Vaultwarden wiki for more options.
DOMAIN=https://vault.xxvlab.com
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
# Argon2 hash from `docker run --rm -it vaultwarden/server:1.37.5-alpine /vaultwarden hash`.
# Write each $ in the hash as $$, or Compose treats it as a variable.
ADMIN_TOKEN=
IP_HEADER=X-Real-IP
TZ=UTC
