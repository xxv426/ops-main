# /etc/ops/backup.env (root, mode 600). Never commit this file.
#
# A target is a named restic repository. Apps list target names in
# BACKUP_TARGETS. Define a target with TARGET_<NAME>_REPOSITORY; any other
# TARGET_<NAME>_<VAR> is exported as <VAR> while restic talks to that target.

RESTIC_PASSWORD_FILE=/etc/ops/restic-password

# Another server over SFTP. On that server: ops backup-client add <name> '<key>'
# Use root's key here (/root/.ssh/id_ed25519) and add the server to known_hosts.
#TARGET_REMOTE_REPOSITORY=sftp:backup-<name>@<host>:/srv/backup/<name>

# An S3-compatible bucket such as Backblaze B2. Give each server its own prefix
# and a key limited to that prefix.
#TARGET_B2_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<bucket>/<prefix>
#TARGET_B2_AWS_ACCESS_KEY_ID=
#TARGET_B2_AWS_SECRET_ACCESS_KEY=
