# /etc/ops/alert.env (root, mode 600). Never commit this file.

# Alert email. smtps:// connects with TLS (usually port 465); smtp:// on 587
# upgrades with STARTTLS. Use an app password, not the account password.
SMTP_URL=smtps://smtp.example.com:465
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# Optional: report each app's nightly backup to an external monitor, so a dead
# server is noticed too. {host}, {app} and {success} are filled in.
# For Gatus external endpoints (group "backup", name "<host>-<app>"):
#HEARTBEAT_URL=http://<monitor>:8080/api/v1/endpoints/backup_{host}-{app}/external?success={success}
#HEARTBEAT_TOKEN=
