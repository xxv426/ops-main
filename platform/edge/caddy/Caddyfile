# Snippets any app's site.caddy can use with `import <name>`.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# For static sites built with hashed asset names under a common path, such as
# Astro's /_astro/. Usage: import static_site <site> <hashed path prefix>
(static_site) {
	root * /srv/www/{args[0]}/current

	@hashed path {args[1]}*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@unhashed not path {args[1]}*
	header @unhashed Cache-Control "public, max-age=0, must-revalidate"

	file_server {
		precompressed br gzip
	}

	handle_errors {
		@notFound expression {err.status_code} == 404
		rewrite @notFound /404.html
		file_server {
			precompressed br gzip
		}
	}
}

# One site.caddy per app. Directories without one are skipped.
import /etc/ops-apps/*/site.caddy
